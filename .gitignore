# -----------------------------------------------------------------
# Grit — root .gitignore
# -----------------------------------------------------------------

# Node (ad-hoc admin scripting only — see package.json)
node_modules/
npm-debug.log*

# Flutter / Dart build output & tooling caches
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/.pub-cache/
mobile/.pub/
**/*.iml
**/.idea/workspace.xml

# Platform-generated plugin registrants / ephemeral build state
# (regenerated by `flutter pub get` — machine- and Flutter-version-specific)
mobile/android/**/GeneratedPluginRegistrant.java
mobile/android/local.properties
mobile/ios/**/GeneratedPluginRegistrant.*
mobile/linux/flutter/ephemeral/
mobile/linux/flutter/generated_plugin*
mobile/macos/Flutter/GeneratedPluginRegistrant.swift
mobile/windows/flutter/ephemeral/
mobile/windows/flutter/generated_plugin*

# Supabase CLI local/link state (machine-specific, regenerated by `supabase link`)
supabase/.temp/
supabase/.branches/

# Secrets — never track real credentials; commit only the .env.example templates
.env
*.env
!*.env.example

# OS cruft
.DS_Store
Thumbs.db

# Local diagnostics, editor settings, machine-specific helper scripts
mobile/_diag/
.idea/
mobile/grit_*.bat
