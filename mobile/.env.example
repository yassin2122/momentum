# -----------------------------------------------------------------
# Momentum - Flutter App Environment Variables
# Copy to .env and fill in from Supabase Dashboard -> Project Settings -> API.
# Passed to the app via: flutter run --dart-define-from-file=.env
# Safe to expose in the client — this is the publishable/anon key, not service_role.
# -----------------------------------------------------------------

SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable-or-anon-key>
