diff --git a/supabase/migrations/20261008000001_fix_signup_trigger_search_path.sql b/supabase/migrations/20261008000001_fix_signup_trigger_search_path.sql
new file mode 100644
index 0000000..71a396a
--- /dev/null
+++ b/supabase/migrations/20261008000001_fix_signup_trigger_search_path.sql
@@ -0,0 +1,54 @@
+-- FIX: sign-up / first login failing with "Database error saving new user".
+--
+-- Cause: handle_new_user() and initialize_user_skill_progress() are
+-- SECURITY DEFINER but had no fixed search_path. The auth.users trigger runs
+-- in the auth service's context where `public` is not on the search_path, so
+-- the unqualified enum casts (skill_status) failed and rolled back the signup.
+-- Fix: pin search_path and schema-qualify the enum type.
+
+create or replace function public.initialize_user_skill_progress(p_user_id uuid)
+returns void
+language plpgsql
+security definer
+set search_path = public, pg_temp
+as $$
+begin
+  insert into public.skill_progress (user_id, skill_id, status)
+  select p_user_id, s.id,
+    case when not exists (select 1 from public.skill_prerequisites sp where sp.skill_id = s.id)
+         then 'available'::public.skill_status else 'locked'::public.skill_status end
+  from public.skills s
+  where s.deleted_at is null and s.is_active
+  on conflict (user_id, skill_id) do nothing;
+end;
+$$;
+
+create or replace function public.handle_new_user()
+returns trigger
+language plpgsql
+security definer
+set search_path = public, pg_temp
+as $$
+begin
+  insert into public.profiles (id, username)
+  values (new.id, 'user_' || substr(replace(new.id::text, '-', ''), 1, 8))
+  on conflict (id) do nothing;
+  perform public.initialize_user_skill_progress(new.id);
+  return new;
+end;
+$$;
+
+drop trigger if exists on_auth_user_created on auth.users;
+create trigger on_auth_user_created
+  after insert on auth.users
+  for each row execute function public.handle_new_user();
+
+-- Backfill: accounts created while the trigger was failing/partial.
+insert into public.profiles (id, username)
+select u.id, 'user_' || substr(replace(u.id::text, '-', ''), 1, 8)
+from auth.users u
+left join public.profiles p on p.id = u.id
+where p.id is null
+on conflict (id) do nothing;
+
+select public.initialize_user_skill_progress(id) from public.profiles;
